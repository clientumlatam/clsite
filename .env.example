# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this applet or API is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret used to sign session cookies.
SESSION_SECRET="clientum-dev-fallback-secret-change-in-prod"

# CRM_INTERNAL_TOKEN: Internal token for WordPress plugin / webhook authentication.
CRM_INTERNAL_TOKEN="dev-crm-internal-token-secret"

# SANTI_API_KEY: Internal server-to-server API key for Santi SDR agent calls.
SANTI_API_KEY="santi-dev-api-key-secret"

# DATABASE_URL: Postgres database connection string.
DATABASE_URL=""

# NEON_DATABASE_URL: Neon pooled Postgres connection string.
NEON_DATABASE_URL=""

# NEON_API_KEY: Neon API key for live branch / project management.
NEON_API_KEY=""

# NEON_PROJECT_ID: Neon project identifier.
NEON_PROJECT_ID=""

# APIFY_API_TOKEN: Apify token for Google Maps scraping.
APIFY_API_TOKEN=""

# GOOGLE_MAPS_PLATFORM_KEY: Google Places API key.
GOOGLE_MAPS_PLATFORM_KEY=""

# HUNTER_API_KEY: Hunter.io API key for email enrichment.
HUNTER_API_KEY=""

# SMTP_USER & SMTP_PASS: Gmail SMTP credentials for sending email notifications.
SMTP_USER=""
SMTP_PASS=""
