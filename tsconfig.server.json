{
  "extends": "./tsconfig.base.json",
  "include": ["server.ts", "index.ts", "api/**/*.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "noImplicitAny": false,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true
  }
}
